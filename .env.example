# PostgreSQL
POSTGRES_DB=rag_system
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=rag_redis_password

# MinIO
MINIO_ROOT_USER=rag_minio
MINIO_ROOT_PASSWORD=rag_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=rag-documents

# OpenSearch local service
OPENSEARCH_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

# Search engine
SEARCH_ENGINE_PROVIDER=opensearch
SEARCH_INDEX_NAME=casting_chunks_v1
SEARCH_INDEX_ALIAS=casting_chunks_current
SEARCH_ENGINE_URL=http://localhost:9200
SEARCH_ENGINE_USERNAME=
SEARCH_ENGINE_PASSWORD=
SEARCH_ENGINE_VERIFY_SSL=false
SEARCH_ENGINE_TIMEOUT_SECONDS=30
SEARCH_ENGINE_MAX_RETRIES=3
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_VECTOR_SPACE=cosine
SEARCH_CONTENT_ANALYZER=ik_max_word
SEARCH_QUERY_ANALYZER=ik_smart

# Hybrid retrieval
HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_RRF_K=60
HYBRID_KEYWORD_TOP_K=50
HYBRID_VECTOR_TOP_K=50
HYBRID_FINAL_LIMIT=10

# OpenAI-compatible LLM provider
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120

# RAG minimal chain
RAG_TOP_K=8
RAG_CONTEXT_MAX_CHARS=12000
RAG_REQUIRE_CITATIONS=true
RAG_NO_CONTEXT_MESSAGE=当前知识库中未检索到足够依据，无法可靠回答该问题。
RAG_SYSTEM_PROMPT_NAME=casting_rag_default

# Reranker reserved for later phases
RERANKER_ENABLED=false
RERANKER_PROVIDER=local_qwen3
RERANKER_MODEL=Qwen3-Reranker-0.6B
RERANKER_MODEL_PATH=D:/rag_system/models/Qwen3-Reranker-0.6B
RERANKER_TOP_K=8
# Phase 7 knowledge extraction limits.
# KNOWLEDGE_EXTRACTION_DEFAULT_STATUS must stay draft.
# pending_review is only triggered by auto_submit=true; approved is never a default extraction status.
KNOWLEDGE_EXTRACTION_MAX_CHUNKS=20
KNOWLEDGE_EXTRACTION_MAX_CHARS=12000
KNOWLEDGE_EXTRACTION_DEFAULT_STATUS=draft
