APP_ENV=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5432/rag_system

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=rag_redis_password

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=rag_minio
MINIO_ROOT_PASSWORD=rag_minio_password
MINIO_BUCKET=rag-documents
MINIO_SECURE=false
# Phase 10 deletion clients use this bounded timeout and disable SDK retries.
DOCUMENT_DELETION_STORAGE_TIMEOUT_SECONDS=30

UPLOAD_MAX_FILE_SIZE_BYTES=52428800
# This deployment allowlist can narrow supported types, never add unsupported ones.
# Markdown upload is allowed; native parsing is unavailable until Phase 11 M3.
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.bmp,.webp,.md
UPLOAD_ALLOWED_CONTENT_TYPES=
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=100

EMBEDDING_PROVIDER=local_qwen3
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_MODEL_PATH=D:/rag_system/models/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_QUERY_INSTRUCTION=Given a search query about casting process knowledge, retrieve relevant document chunks that answer the query.
EMBEDDING_USE_QUERY_INSTRUCTION=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

SEARCH_ENGINE_PROVIDER=opensearch
SEARCH_INDEX_NAME=casting_chunks_v1
SEARCH_INDEX_ALIAS=casting_chunks_current
SEARCH_ENGINE_URL=http://localhost:9200
SEARCH_ENGINE_USERNAME=
SEARCH_ENGINE_PASSWORD=
SEARCH_ENGINE_VERIFY_SSL=false
SEARCH_ENGINE_TIMEOUT_SECONDS=30
SEARCH_ENGINE_MAX_RETRIES=3
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_VECTOR_SPACE=cosine
SEARCH_CONTENT_ANALYZER=ik_max_word
SEARCH_QUERY_ANALYZER=ik_smart

HYBRID_KEYWORD_WEIGHT=0.5
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_RRF_K=60
HYBRID_KEYWORD_TOP_K=50
HYBRID_VECTOR_TOP_K=50
HYBRID_FINAL_LIMIT=10

LLM_PROVIDER=local
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

LLM_REMOTE_BASE_URL=
LLM_REMOTE_API_KEY=
LLM_REMOTE_MODEL=
LLM_REMOTE_TIMEOUT_SECONDS=60
LLM_REMOTE_SUPPORTS_JSON_MODE=false
LLM_REMOTE_ALLOW_INSECURE_HTTP=false

RAG_TOP_K=8
RAG_CONTEXT_MAX_CHARS=12000
RAG_REQUIRE_CITATIONS=true
RAG_NO_CONTEXT_MESSAGE=当前知识库中未检索到足够依据，无法可靠回答该问题。
RAG_SYSTEM_PROMPT_NAME=casting_rag_default

RERANKER_ENABLED=true
RERANKER_PROVIDER=local_transformers
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_PATH=D:/rag_system/models/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANKER_DTYPE=bf16
RERANKER_CANDIDATE_LIMIT=32
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=1024
RERANKER_TIMEOUT_SECONDS=5

KNOWLEDGE_EXTRACTION_MAX_CHUNKS=20
KNOWLEDGE_EXTRACTION_MAX_CHARS=12000
KNOWLEDGE_EXTRACTION_DEFAULT_STATUS=draft

# ---------------------------------------------------------------------------
# Document parser / MinerU API
# ---------------------------------------------------------------------------
# 唯一允许的 provider 为 mineru_api；其他值在 Settings 加载时拒绝。
# provider=mineru_api 时，MINERU_API_BASE_URL / MINERU_API_KEY 等配置缺失会报明确错误，
# 不会使用替代解析器。Markdown 路由独立，P0 暂返回 DOCUMENT_PARSER_UNAVAILABLE。
DOCUMENT_PARSER_PROVIDER=mineru_api
# 仅配置 MinerU 官方域名；transport 会自行拼接 /api/v4/... 路径。
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_KEY=
MINERU_API_TIMEOUT_SECONDS=120
MINERU_API_POLL_INTERVAL_SECONDS=5
MINERU_API_MAX_POLL_ATTEMPTS=120
# 正式使用推荐 vlm；兼容值 auto 会在客户端内部映射为 vlm。
MINERU_PARSE_MODE=vlm
MINERU_ENABLE_OCR=true
MINERU_OUTPUT_PREFIX=parsed-assets

# Phase 11 graph retrieval: disabled by default; no startup connection.
# Owner must provision a database-level read-only account before enabling.
# READ access mode is routing only; never use the importer account here.
GRAPH_RETRIEVAL_ENABLED=false
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
GRAPH_RETRIEVAL_MAX_ANCHORS=8
GRAPH_RETRIEVAL_MAX_ENTITIES_PER_ANCHOR=200
GRAPH_RETRIEVAL_MAX_RELATIONSHIPS_PER_ANCHOR=400
GRAPH_RETRIEVAL_QUERY_TIMEOUT_SECONDS=2
GRAPH_RETRIEVAL_TOTAL_BUDGET_SECONDS=5
NEO4J_CONNECTION_TIMEOUT_SECONDS=1
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=1
