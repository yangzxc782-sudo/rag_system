{
  "version": "4.0.0",
  "name": "材料标准知识抽取模板",
  "purpose": "从铸造材料标准中抽取知识，输出实体和关系，用于构建知识图谱。模板是唯一依据：只允许出现 entity_type_whitelist 中的实体类型和 relation_type_whitelist 中的关系类型。不清洗原文、不补全表中没有的行。",
  "authority_rules": [
    "本模板是唯一权威。",
    "实体 type 必须属于 entity_type_whitelist。",
    "关系 type 必须属于 relation_type_whitelist，且必须满足 from/to 约束。",
    "每个实体和关系必须带 provenance_object。",
    "数值必须使用 value_object，禁止裸字符串数值。",
    "name 是实体的主名称，用于图谱检索；与 name 重复的信息不得再作为属性。",
    "材料大类是顶层分类。标准名称含「铸件」时，链路为：材料大类 → 具有铸件 → 铸件 → 具有牌号 → 牌号；不含「铸件」时，链路为：材料大类 → 具有 → 牌号。"
  ],
  "standard_name_judgment": {
    "description": "根据标准名称判断牌号是否经过铸件挂接",
    "rules": [
      {
        "condition": "标准名称中包含「铸件」二字",
        "action": "建铸件实体。材料大类-具有铸件->铸件；铸件-属于材料大类->材料大类；铸件-具有牌号->牌号；牌号-属于铸件->铸件。标志、包装、运输、贮存、修补、矫正、质量验收均挂到铸件下。",
        "examples": [
          "铝合金气缸盖铸件",
          "一般工程用铸造碳钢件",
          "球墨铸铁件",
          "压铸铝合金铸件"
        ]
      },
      {
        "condition": "标准名称中不包含「铸件」二字",
        "action": "不建铸件实体。材料大类-具有->牌号。牌号不挂到任何铸件下。",
        "examples": [
          "压铸铝合金",
          "回收铝合金",
          "铸造铝合金",
          "铸造镁合金",
          "铸造铜合金"
        ]
      }
    ]
  },
