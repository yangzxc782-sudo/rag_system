  "value_object": {
    "description": "所有数值型属性统一使用此结构，禁止裸字符串",
    "fields": {
      "raw": "原文片段，如 ≥155、≤0.20、余量、2~6",
      "value": "数值或 null",
      "unit": "单位或 null",
      "comparator": ">=、<=、=、范围、余量、null",
      "min": "下限或 null",
      "max": "上限或 null",
      "typical": "典型值或 null"
    }
  },
  "provenance_object": {
    "description": "每个实体和关系必须带此结构",
    "fields": {
      "标准号": "完整标准号，如 GB/T 1173",
      "条款号": "条款号或 null",
      "表号": "表号或 null",
      "附录号": "附录号或 null",
      "原文": "原文片段"
    }
  },
